{
  "name": "Link'em",
  "description": "Add links to web pages wherever you want!",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "submit:edge": "npm run zip && wxt submit --edge-zip .output/linkem-%npm_package_version%-chrome.zip",
    "submit:chrome": "npm run zip && wxt submit --chrome-zip .output/linkem-%npm_package_version%-chrome.zip",
    "submit:firefox": "npm run zip && wxt submit --firefox-zip .output/linkem-%npm_package_version%-firefox.zip --firefox-sources-zip .output/linkem-%npm_package_version%-sources.zip",
    "submit:all": "npm run zip && wxt submit --chrome-zip .output/linkem-%npm_package_version%-chrome.zip --firefox-zip .output/linkem-%npm_package_version%-firefox.zip --firefox-sources-zip .output/linkem-%npm_package_version%-sources.zip --edge-zip .output/linkem-%npm_package_version%-chrome.zip",
    "test": "npm run build && playwright test --config tests/playwright.config.ts",
    "test:headed": "npm run build && playwright test --config tests/playwright.config.ts --headed",
    "test:ui": "npm run build && playwright test --config tests/playwright.config.ts --ui",
    "test:debug": "npm run build && playwright test --config tests/playwright.config.ts --debug"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "supabase": "^2.105.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  }
}
